---
kind: Ingress
apiVersion: networking.k8s.io/v1
metadata:
  name: mini-apps-ui
  namespace: {{ ui_namespace }}
  annotations:
    cert-manager.io/cluster-issuer: "letsencrypt-nginx-{{ ui_cert_issuer|lower }}"
    nginx.ingress.kubernetes.io/proxy-body-size: "{{ ui_ingress_proxy_body_size }}"
    nginx.ingress.kubernetes.io/proxy-buffer-size: "128k"
    nginx.ingress.kubernetes.io/proxy-buffers-number: "4"
    # For a full set of nginx annotations see...
    # https://kubernetes.github.io/ingress-nginx/user-guide/nginx-configuration/annotations/
spec:
  ingressClassName: nginx
  tls:
  - hosts:
    - {{ ui_hostname }}
    secretName: mini-apps-ui-tls
  rules:
  - host: {{ ui_hostname }}
    http:
      paths:
      - path: /{{ ui_hostname_path }}
        pathType: Prefix
        backend:
          service:
            name: mini-apps-ui
            port:
              name: http
